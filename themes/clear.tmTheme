<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key><string>clear</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#0C0C0C</string>
        <key>foreground</key><string>#CCCCCC</string>
        <key>caret</key><string>#CCCCCC</string>
        <key>selection</key><string>#264F78</string>
        <key>lineHighlight</key><string>#161616</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key><dict><key>foreground</key><string>#767676</string></dict>
    </dict>
    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string, punctuation.definition.string</string>
      <key>settings</key><dict><key>foreground</key><string>#13A10E</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Number and constant</string>
      <key>scope</key><string>constant.numeric, constant.language, constant.character, constant.other</string>
      <key>settings</key><dict><key>foreground</key><string>#C19C00</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword, storage, storage.type, storage.modifier</string>
      <key>settings</key><dict><key>foreground</key><string>#881798</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Function</string>
      <key>scope</key><string>entity.name.function, support.function, meta.function-call</string>
      <key>settings</key><dict><key>foreground</key><string>#3B78FF</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Type and class</string>
      <key>scope</key><string>entity.name.type, entity.name.class, support.type, support.class</string>
      <key>settings</key><dict><key>foreground</key><string>#3A96DD</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Variable</string>
      <key>scope</key><string>variable, variable.parameter</string>
      <key>settings</key><dict><key>foreground</key><string>#CCCCCC</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Tag</string>
      <key>scope</key><string>entity.name.tag, entity.other.attribute-name</string>
      <key>settings</key><dict><key>foreground</key><string>#C50F1F</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid</string>
      <key>settings</key><dict><key>foreground</key><string>#C50F1F</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Inline code</string>
      <key>scope</key><string>markup.inline.raw, markup.raw.inline</string>
      <key>settings</key><dict><key>foreground</key><string>#3B78FF</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Diff inserted</string>
      <key>scope</key><string>markup.inserted, diff.inserted</string>
      <key>settings</key><dict><key>background</key><string>#005F00</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Diff deleted</string>
      <key>scope</key><string>markup.deleted, diff.deleted</string>
      <key>settings</key><dict><key>background</key><string>#5F0000</string></dict>
    </dict>
  </array>
</dict>
</plist>
